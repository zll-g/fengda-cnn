{
  "ServiceName": "Fengda.Boiler.WebApi",
  "Monitoring": {
    "EndpointUrl": "opc.tcp://10.15.3.219:12081",
    "OutputDirectory": "artifacts",
    "DatabaseDirectory": "data",
    "FaultDatabasePath": "data/faults.db",
    "SnapshotIntervalSeconds": 1,
    "ReconnectDelaySeconds": 5
  },
  "Prediction": {
    "ModelDirectory": "model",
    "MaxSnapshotAgeSeconds": 5
  },
  "EarlyWarning": {
    "Enabled": true,
    "ModelDirectory": "model/early-warning",
    "PollIntervalMilliseconds": 250
  },
  "EmissionBounds": {
    "Enabled": true,
    "ModelDirectory": "model/emission_bounds",
    "DatabasePath": "data/emission_bounds.db",
    "PollIntervalMilliseconds": 250,
    "MaxSnapshotAgeSeconds": 5,
    "EventCooldownMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
